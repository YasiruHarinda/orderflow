{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Warning"
    }
  },
  "AllowedHosts": "*",
  "RateLimiting": {
    "PermitLimit": 100,
    "WindowSeconds": 10
  },
  "ReverseProxy": {
    "Routes": {
      "orders": {
        "ClusterId": "orders",
        "RateLimiterPolicy": "per-client",
        "Match": { "Path": "/api/v1/orders/{**rest}" }
      },
      "products": {
        "ClusterId": "inventory",
        "RateLimiterPolicy": "per-client",
        "Match": { "Path": "/api/v1/products/{**rest}" }
      }
    },
    "Clusters": {
      "orders": {
        "HealthCheck": {
          "Active": { "Enabled": true, "Interval": "00:00:10", "Timeout": "00:00:05", "Path": "/health/ready" }
        },
        "Destinations": {
          "orders-api": { "Address": "http://orders-api" }
        }
      },
      "inventory": {
        "HealthCheck": {
          "Active": { "Enabled": true, "Interval": "00:00:10", "Timeout": "00:00:05", "Path": "/health/ready" }
        },
        "Destinations": {
          "inventory-api": { "Address": "http://inventory-api" }
        }
      }
    }
  }
}
