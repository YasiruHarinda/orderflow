<Project>
  <!--
    Central Package Management: every NuGet package version lives here.
    Projects reference packages WITHOUT a version, e.g.
      <PackageReference Include="MediatR" />
  -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <ItemGroup>
    <!-- Packages are added here as we need them in later parts. -->
  </ItemGroup>
</Project>
