<?xml version="1.0" encoding="utf-8"?>
<!--
  Code coverage settings. Coverage is measured on the Domain and Application layers only:
  that is where the business rules live, and where unit tests should be thorough.
  Infrastructure and APIs are covered by the integration tests instead.
-->
<RunSettings>
  <DataCollectionRunSettings>
    <DataCollectors>
      <DataCollector friendlyName="XPlat Code Coverage">
        <Configuration>
          <Format>cobertura</Format>
          <Include>[*.Domain]*,[*.Application]*</Include>
          <ExcludeByAttribute>GeneratedCodeAttribute,CompilerGeneratedAttribute,ExcludeFromCodeCoverageAttribute</ExcludeByAttribute>
        </Configuration>
      </DataCollector>
    </DataCollectors>
  </DataCollectionRunSettings>
</RunSettings>
